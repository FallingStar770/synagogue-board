# Single-service image for Render (or any PaaS): builds both front-ends and serves them together
# with the API from one HTTPS origin. Images are stored in PostgreSQL, so no disk is required.
FROM node:22-alpine AS web
WORKDIR /src
COPY apps/admin/package*.json apps/admin/
COPY apps/display/package*.json apps/display/
RUN cd apps/admin && npm ci && cd ../display && npm ci
COPY apps ./apps
RUN cd apps/admin && npm run build && cd ../display && npm run build

FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    ADMIN_STATIC_DIR=/app/static/admin DISPLAY_STATIC_DIR=/app/static/display MEDIA_DIR=/tmp/media
WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini backend/docker-entrypoint.sh ./
COPY --from=web /src/apps/admin/dist ./static/admin
COPY --from=web /src/apps/display/dist ./static/display
RUN chmod +x docker-entrypoint.sh
USER app
EXPOSE 10000
ENTRYPOINT ["./docker-entrypoint.sh"]
