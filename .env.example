# ---- copy to .env and change every value. Never commit .env ----
POSTGRES_DB=synagogue
POSTGRES_USER=synagogue
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# first administrator (created only when the users table is empty; change the password after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-Strong-Passw0rd

# production behind HTTPS: true (cookies get the Secure flag, HSTS header is sent)
COOKIE_SECURE=false
SESSION_HOURS=12
ENVIRONMENT=development
# exact origins only if admin is served from another domain (normally empty = same origin)
CORS_ORIGINS=
MAX_UPLOAD_MB=5
SNAPSHOT_DAYS=400
# demo content clearly marked as samples (dev only)
SEED_DEMO=false
# for the https profile
DOMAIN=board.example.org
